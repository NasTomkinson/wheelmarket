{
  "collectionName": "components_data_vehicle_wheel_fitments",
  "info": {
    "displayName": "Vehicle Wheel Fitment",
    "description": "An OEM wheel and tyre specification for one axle or both axles"
  },
  "options": {},
  "attributes": {
    "setupName": {
      "type": "string",
      "required": true,
      "maxLength": 100
    },
    "axle": {
      "type": "enumeration",
      "enum": [
        "both",
        "front",
        "rear"
      ],
      "required": true,
      "default": "both"
    },
    "wheelDiameter": {
      "type": "integer",
      "required": true,
      "min": 10,
      "max": 30
    },
    "wheelWidth": {
      "type": "decimal",
      "required": true,
      "min": 3,
      "max": 20
    },
    "offset": {
      "type": "decimal",
      "required": true,
      "min": -100,
      "max": 100
    },
    "tyreWidth": {
      "type": "integer",
      "min": 100,
      "max": 500
    },
    "tyreAspectRatio": {
      "type": "integer",
      "min": 20,
      "max": 100
    },
    "tyreLoadIndex": {
      "type": "integer",
      "min": 50,
      "max": 150
    },
    "tyreSpeedRating": {
      "type": "string",
      "maxLength": 5
    },
    "isOem": {
      "type": "boolean",
      "required": true,
      "default": true
    },
    "notes": {
      "type": "string",
      "maxLength": 300
    }
  },
  "config": {}
}
